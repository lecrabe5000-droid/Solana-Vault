// Cloudflare Worker for ecrinprotocol.app: the site in app/, redirects to the canonical host, and Ecrin alerts.
// Alerts: set TELEGRAM_BOT_TOKEN and/or RESEND_API_KEY as secrets (Settings → Variables and Secrets).
// Optional ALERTS_FROM, e.g. "Ecrin Alerts <alerts@ecrinprotocol.app>" (the domain must be verified in Resend).
{
  "name": "solana-vault",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./app",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "AlertHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AlertHub"] }],
  "triggers": { "crons": ["* * * * *"] }
}
