{
  "manifest_version": 3,
  "name": "Ecrin Wallet",
  "short_name": "Ecrin",
  "version": "0.1.0",
  "description": "A wallet for spending, a safe nobody can rush. Solana and Ethereum. Testnet beta.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ecrin Wallet",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "bg.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.devnet.solana.com/*",
    "https://*.publicnode.com/*",
    "https://api.coingecko.com/*",
    "https://api.binance.com/*",
    "https://api.exchange.coinbase.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; frame-ancestors 'none'"
  },
  "minimum_chrome_version": "116"
}
